{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RTDS source catalog 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "catalog_version",
    "checked_utc",
    "scope",
    "manual_reference",
    "confidence_definition",
    "policies",
    "sources",
    "variants"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "catalog_version": {
      "const": "0.1.0"
    },
    "checked_utc": {
      "type": "string",
      "format": "date"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "manual_reference": {
      "type": "object",
      "required": [
        "title",
        "access",
        "redistribution"
      ],
      "properties": {
        "title": {
          "const": "RTDS Hardware Manual"
        },
        "access": {
          "const": "private_user_provided"
        },
        "redistribution": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "confidence_definition": {
      "type": "object",
      "required": [
        "documented",
        "observed",
        "partial",
        "unknown",
        "conflicting"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "policies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "access",
          "date",
          "date_meaning",
          "url"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "access": {
            "enum": [
              "private_user_provided",
              "public_reference_only"
            ]
          },
          "date": {
            "type": [
              "string",
              "null"
            ]
          },
          "date_meaning": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "if": {
          "properties": {
            "access": {
              "const": "private_user_provided"
            }
          }
        },
        "then": {
          "properties": {
            "title": {
              "const": "RTDS Hardware Manual"
            },
            "date": {
              "type": "null"
            },
            "url": {
              "type": "null"
            }
          }
        }
      }
    },
    "variants": {
      "type": "array",
      "minItems": 18,
      "items": {
        "$ref": "#/$defs/variant"
      }
    }
  },
  "$defs": {
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim",
        "source_refs",
        "locator"
      ],
      "properties": {
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "locator": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "facts",
        "gaps"
      ],
      "properties": {
        "status": {
          "enum": [
            "documented",
            "observed",
            "partial",
            "unknown",
            "conflicting"
          ]
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "family",
        "generation",
        "identity_scope",
        "evidence",
        "confidence",
        "release_gate",
        "notes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9.-]+$"
        },
        "family": {
          "type": "string",
          "minLength": 1
        },
        "generation": {
          "type": "string",
          "minLength": 1
        },
        "identity_scope": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_id",
              "locator"
            ],
            "properties": {
              "source_id": {
                "type": "string",
                "minLength": 1
              },
              "locator": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "confidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "count",
            "layout",
            "keying",
            "contacts",
            "physical_dimensions",
            "electrical_compatibility"
          ],
          "properties": {
            "count": {
              "$ref": "#/$defs/dimension"
            },
            "layout": {
              "$ref": "#/$defs/dimension"
            },
            "keying": {
              "$ref": "#/$defs/dimension"
            },
            "contacts": {
              "$ref": "#/$defs/dimension"
            },
            "physical_dimensions": {
              "$ref": "#/$defs/dimension"
            },
            "electrical_compatibility": {
              "$ref": "#/$defs/dimension"
            }
          }
        },
        "release_gate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stage",
            "accurate_connector_release_passed",
            "blockers"
          ],
          "properties": {
            "stage": {
              "enum": [
                "catalog_only",
                "exterior_candidate",
                "connector_research_candidate"
              ]
            },
            "accurate_connector_release_passed": {
              "const": false
            },
            "blockers": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
