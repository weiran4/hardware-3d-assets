  "review_scope": [
    "Actual private manual text and board/terminal figures, with selected PCB revisions kept distinct.",
    "Official Phoenix Contact part pages for documented 3.81 mm terminal pitch and plug envelopes.",
    "Reopened each saved BLEND and separately imported each actual GLB.",
    "Contact counts, top-to-bottom semantics, outward aperture rays, four-quadrant optical visibility, key-slot visibility, anchor frames, unknown-service gates.",
    "Every font tested against complete-scene mesh geometry using glyph vertices/triangle-centroid sight lines, not root-only bounding boxes.",
    "Connector seating plus conservative PCB-connected assembly-support graph and all four side views.",
    "All 33 final previews visually inspected, including 9 interface closeups; byte/pixel/source hashes independently checked."
  ],
  "resolved_before_acceptance": [
    "Heatsink hidden-core/cap coplanar shading.",
    "Decorative/text and label/connector overlaps, including all font descendants.",
    "Terminal close-up camera elevations lowered to reveal actual wire-entry contacts; no geometry change."
  ],
